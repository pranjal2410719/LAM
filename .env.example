# LAM Environment Configuration Template
# Copy to .env and adjust values for your local environment

# Database Configuration
# For local SQLite development:
DATABASE_URL=sqlite+aiosqlite:///./lam_dev.db

# For PostgreSQL container/production:
# DATABASE_URL=postgresql+asyncpg://lam_user:lam_password@localhost:5432/lam_db

# Service Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
