# LAM Local Development Environment Configuration Template
# For local Python execution (SQLite by default).
#
# Copy this file to .env:
#   Windows PowerShell: Copy-Item .env.example .env
#   Linux / macOS:      cp .env.example .env
#
# (Note: For the multi-container Docker Compose workflow, use .env.compose.example instead)

# ==============================================================================
# Database Configuration (Local Development)
# ==============================================================================
# Zero-dependency local SQLite database (default for development):
DATABASE_URL=sqlite+aiosqlite:///./lam_dev.db

# If connecting locally to an existing external PostgreSQL daemon:
# DATABASE_URL=postgresql+asyncpg://lam_user:your_password@localhost:5432/lam_db

# ==============================================================================
# Service Server Settings
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# ==============================================================================
# Authentication & Security (JWT)
# ==============================================================================
# In production, LAM enforces fail-closed validation:
# LAM_JWT_SECRET_KEY must be explicitly configured, at least 32 characters, and not the dev default.
LAM_JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-key-32chars
LAM_JWT_ALGORITHM=HS256
LAM_JWT_ISSUER=lam-auth
LAM_JWT_AUDIENCE=lam-service
