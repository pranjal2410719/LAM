# LAM Docker Compose Environment Configuration Template
# Copy this file to .env.compose (or export variables in your shell) before running docker compose:
#   Windows PowerShell: Copy-Item .env.compose.example .env.compose
#   Linux / macOS:      cp .env.compose.example .env.compose
#
# Then run Compose pointing to this env file:
#   docker compose --env-file .env.compose up --build

# ==============================================================================
# PostgreSQL Service Settings (Database Container)
# ==============================================================================
POSTGRES_USER=lam_user
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=lam_db
POSTGRES_HOST_PORT=5432

# ==============================================================================
# LAM API Service Settings (Application Container)
# ==============================================================================
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST_PORT=8000

# ==============================================================================
# Authentication & Security (JWT)
# ==============================================================================
# If ENVIRONMENT=production, LAM enforces fail-closed validation:
# LAM_JWT_SECRET_KEY must be at least 32 characters, high-entropy, and not the dev default.
LAM_JWT_SECRET_KEY=change-this-in-production-to-a-secure-random-key-32chars
LAM_JWT_ALGORITHM=HS256
LAM_JWT_ISSUER=lam-auth
LAM_JWT_AUDIENCE=lam-service

# ==============================================================================
# Database URL for Docker Network (Optional Override)
# ==============================================================================
# By default, Compose constructs:
# postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
# If your password contains URL-reserved characters (e.g. @, :, /), provide the
# percent-encoded connection string here:
# COMPOSE_DATABASE_URL=postgresql+asyncpg://lam_user:percent_encoded_password@postgres:5432/lam_db
